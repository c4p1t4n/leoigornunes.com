---
// Menu de seções (tags em destaque) + Arquivo/Sobre. No mobile vira faixa com scroll horizontal interno.
import { site } from '../config/site';
import { tagLabel } from '../lib/tags';

const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---

<nav class="nav" aria-label="Seções">
  <div class="container strip">
    <ul>
      {site.featuredTags.map((t) => (
        <li>
          <a href={`/tags/${t}/`} aria-current={current(`/tags/${t}/`)}>
            {tagLabel(t)}
          </a>
        </li>
      ))}
    </ul>
    <ul>
      <li>
        <a href="/arquivo/" aria-current={current('/arquivo/')}>
          Arquivo
        </a>
      </li>
      <li>
        <a href="/sobre/" aria-current={current('/sobre/')}>
          Sobre
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    border-bottom: 1px solid var(--rule);
  }
  .strip {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  ul {
    display: flex;
    flex: none;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: block;
    padding-block: 0.85rem;
    border-bottom: 3px solid transparent;
    color: var(--ink);
    font: 600 0.8125rem/1 var(--font-ui);
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }
  a:hover,
  a[aria-current] {
    border-bottom-color: var(--gold);
  }
</style>
