---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
---

<BaseLayout title="Página não encontrada" noindex>
  <div class="container lost">
    <Logo size={160} alt="Corvo de chapéu de palha sobre uma pilha de livros" />
    <h1>Este mapa não leva a lugar nenhum</h1>
    <p>
      O tesouro que você procurava foi enterrado em outro endereço, ou nunca
      existiu.
    </p>
    <p class="row actions">
      <a class="chip" href="/">
        Voltar ao início
      </a>
      <a class="chip" href="/arquivo/">
        Ver o arquivo
      </a>
    </p>
  </div>
</BaseLayout>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-block: 4rem;
    text-align: center;
  }
  h1 {
    margin: 0;
    font: 900 var(--fs-title) / 1.1 var(--font-display);
  }
  p {
    margin: 0;
    max-width: 40ch;
  }
  .actions {
    justify-content: center;
    margin-top: 0.5rem;
  }
</style>
